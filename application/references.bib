	file = {PDF:C\:\\Users\\au621298\\Zotero\\storage\\IANB5WV9\\Santos et al. - 2022 - Detection of exposed steel rebars based on deep-learning techniques and unmanned aerial vehicles.pdf:application/pdf},
}

