@article{zbirovskyOpensourceAutomaticPipeline2025,
	title = {Open-source automatic pipeline for efficient conversion of large-scale point clouds to {IFC} format},
	volume = {177},
	issn = {09265805},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0926580525003437},
	doi = {10.1016/j.autcon.2025.106303},
	abstract = {Building Information Model (BIM) creation usually relies on laborious manual transformation of the unstructured point cloud data provided by laser scans or photogrammetry. This paper presents Cloud2BIM, an open-source software tool designed to automate the conversion of point clouds into BIM models compliant with the Industry Foundation Classes (IFC) standard. Cloud2BIM integrates advanced algorithms for wall and slab segmentation, opening detection, and room zoning based on real wall surfaces, resulting in a comprehensive and fully automated workflow. Unlike existing tools, it avoids computationally- and calibration-intensive techniques such as RANSAC, supports non-orthogonal geometries, and provides unprecedented processing speed, achieving results up to seven times faster than fastest competing solutions. Systematic validation using benchmark datasets confirms that Cloud2BIM is an easy-to-use, efficient, and scalable solution for generating accurate BIM models, capable of converting extensive point cloud datasets for entire buildings into IFC format with minimal user input.},
	language = {en},
	urldate = {2026-07-24},
	journal = {Automation in Construction},
	author = {Zbirovský, Slávek and Nežerka, Václav},
	month = sep,
	year = {2025},
	pages = {106303},
}

@article{zhangPointCloudMultisource2026a,
	title = {Point cloud and multi-source data fusion in the {AEC} industry: {Systematic} review},
	volume = {188},
	issn = {09265805},
	shorttitle = {Point cloud and multi-source data fusion in the {AEC} industry},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0926580526002645},
	doi = {10.1016/j.autcon.2026.107023},
	abstract = {The increasing complexity of construction projects with requirements for precision and semantic richness, has exposed the limitations of single-source point cloud data despite its geometric accuracy. Multi-source data fusion is essential, yet systematic frameworks for classifying fusion types and mapping approaches to applications remain lacking. Following PRISMA methodology, this paper analyzes 175 publications (2019-2025), establishing an approach-application knowledge framework for PCD-X fusion (X: BIM, imagery, thermography, pose data, SHM data) in the AEC industry. The framework organizes research along fusion types and application scenarios. Based on systematic taxonomies, five fusion types are evaluated through implementation methods and performance metrics. These technologies support quality inspection, 3D reconstruction, progress monitoring, and O\&M management. Four fusion-specific challenges are identified: cross-modal representation learning, spatio-temporal consistency, scalable heterogeneous stream processing, and cross-configuration generalization. This review clarifies the current state of PCD-X fusion in the AEC industry and identifies major research trends and future directions.},
	language = {en},
	urldate = {2026-07-24},
	journal = {Automation in Construction},
	author = {Zhang, Shuolin and Wang, Qian and Huang, Hong and Yue, Hongzhe and Li, Zirui and Wang, Boyu},
	month = aug,
	year = {2026},
	pages = {107023},
}

@article{hanClosedloopBIMFramework2026b,
	title = {Closed-loop {BIM} framework for time-integrated bridge damage analysis},
	volume = {189},
	issn = {09265805},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0926580526002955},
	doi = {10.1016/j.autcon.2026.107054},
	abstract = {Bridge maintenance must evolve from one-off inspections to systematically integrating measured and predicted damage with iterative feedback between analysis and Building Information Modeling (BIM). However, existing research focuses on static information, limiting continuous updates and predictive management. To address this, this paper presented a closed-loop framework utilizing a Common Data Environment (CDE) Backend Database (DB) based on the Bridge-Time State Management (B-TSM) schema as the Single Source of Truth (SSOT). The framework automates structural analysis model generation by combining Industry Foundation Classes (IFC) geometric and database state data, accumulating results via a ‘Row-Based Time-Step Strategy’ within a unified time index. Employing State-Enabled Spreadsheet (SES) snapshots as lightweight interfaces inheriting the logical structure of the database, the system ensures data exchange efficiency and integrity. A Proof-of-Concept (PoC) on Reinforced Concrete (RC) slab bridges validated full-cycle data circulation. This research establishes a technical foundation for data-centric architecture driving intelligent maintenance.},
	language = {en},
	urldate = {2026-07-24},
	journal = {Automation in Construction},
	author = {Han, Hyungseo and Shin, Do Hyoung},
	month = sep,
	year = {2026},
	pages = {107054},
}

